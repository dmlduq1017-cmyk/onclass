<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/white">

    <!-- 고정된 Toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar1"
        android:layout_width="match_parent"
        android:layout_height="51dp"
        android:background="#0088FF"
        app:titleTextColor="@color/white"
        tools:ignore="MissingClass">
        <ImageButton
            android:id="@+id/backbtn"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:background="@drawable/ic_action_name"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="회원가입"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:fontFamily="@font/nanumsquareneoalt"
            android:textSize="20sp" />
    </androidx.appcompat.widget.Toolbar>

    <ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:background="@color/white">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:gravity="center">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="회원님에 대하여 알려주세요!"
                android:textSize="20dp"
                android:fontFamily="@font/nanumsquareneoalt"
                android:layout_marginTop="20dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Name"
                android:textSize="15dp"
                android:fontFamily="@font/nanumsquareneodeb"
                android:layout_marginTop="20dp"/>
            <EditText
                android:id="@+id/editTextName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint=" 성함을 입력해주세요"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/nanumsquareneoalt"
                android:background="@drawable/border"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ID"
                android:textSize="15dp"
                android:fontFamily="@font/nanumsquareneodeb"
                android:layout_marginTop="8dp"/>
            <EditText
                android:id="@+id/editTextEmail_signup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint=" 사용하실 아이디를 입력해주세요"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/nanumsquareneoalt"
                android:background="@drawable/border"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Password"
                android:textSize="15dp"
                android:fontFamily="@font/nanumsquareneodeb"
                android:layout_marginTop="8dp"/>
            <EditText
                android:id="@+id/editTextPassword_signup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint=" 대문자, 소문자, 특수기호를 사용해주세요"
                android:inputType="textPassword"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/nanumsquareneoalt"
                android:background="@drawable/border"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Password Check"
                android:textSize="15dp"
                android:fontFamily="@font/nanumsquareneodeb"
                android:layout_marginTop="8dp"/>
            <EditText
                android:id="@+id/editTextConfirmPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint=" 설정한 비밀번호를 한번 더 입력해주세요"
                android:inputType="textPassword"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/nanumsquareneoalt"
                android:background="@drawable/border"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Birth"
                android:textSize="15dp"
                android:fontFamily="@font/nanumsquareneodeb"
                android:layout_marginTop="8dp"/>
            <EditText
                android:id="@+id/editTextBirth"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint=" 생년월일 (YYYY-MM-DD)"
                android:fontFamily="@font/nanumsquareneoalt"
                android:background="@drawable/border"
                android:layout_marginTop="8dp" />

            <RadioGroup
                android:id="@+id/radioGroupGender"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <RadioButton
                    android:id="@+id/radioMale"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/nanumsquareneoalt"
                    android:text="남자" />

                <RadioButton
                    android:id="@+id/radioFemale"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="여자"
                    android:fontFamily="@font/nanumsquareneoalt"
                    android:layout_marginStart="24dp" />
            </RadioGroup>

            <CheckBox
                android:id="@+id/checkBoxTerms"
                android:layout_gravity="left"
                android:layout_width="wrap_content"
                android:layout_height="22dp"
                android:layout_marginTop="12dp"
                app:buttonTint="#0088FF"
                android:fontFamily="@font/nanumsquareneoalt"
                android:text="약관 전체 동의" />
            <CheckBox
                android:id="@+id/checkBoxTerms1"
                android:layout_gravity="left"
                android:layout_width="wrap_content"
                android:layout_height="22dp"
                android:layout_marginTop="8dp"
                app:buttonTint="#0088FF"
                android:fontFamily="@font/nanumsquareneoalt"
                android:text="(필수) 서비스 이용 약관 동의" />
            <CheckBox
                android:id="@+id/checkBoxTerms2"
                android:layout_gravity="left"
                android:layout_width="wrap_content"
                android:layout_height="22dp"
                android:layout_marginTop="8dp"
                app:buttonTint="#0088FF"
                android:fontFamily="@font/nanumsquareneoalt"
                android:text="(필수) 만 14세 이상입니다" />
            <CheckBox
                android:id="@+id/checkBoxTerms3"
                android:layout_gravity="left"
                android:layout_width="wrap_content"
                android:layout_height="22dp"
                android:layout_marginTop="8dp"
                app:buttonTint="#0088FF"
                android:fontFamily="@font/nanumsquareneoalt"
                android:text="(필수) 개인정보 처리방침" />
            <CheckBox
                android:id="@+id/checkBoxTerms4"
                android:layout_gravity="left"
                android:layout_width="wrap_content"
                android:layout_height="22dp"
                android:layout_marginTop="8dp"
                app:buttonTint="#0088FF"
                android:fontFamily="@font/nanumsquareneoalt"
                android:text="(필수) 서비스 이용 약관 동의" />
            <CheckBox
                android:id="@+id/checkBoxTerms5"
                android:layout_gravity="left"
                android:layout_width="wrap_content"
                android:layout_height="22dp"
                android:layout_marginTop="8dp"
                app:buttonTint="#0088FF"
                android:fontFamily="@font/nanumsquareneoalt"
                android:text="(선택) 마케팅 정보 수신동의" />
            <CheckBox
                android:id="@+id/checkBoxTerms6"
                android:layout_gravity="left"
                android:layout_width="wrap_content"
                android:layout_height="22dp"
                android:layout_marginTop="8dp"
                app:buttonTint="#0088FF"
                android:fontFamily="@font/nanumsquareneoalt"
                android:text="(선택) 위치정보에 따른 맞춤형 혜택 수신동의" />
            <Button
                android:id="@+id/buttonSignup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="회원가입 완료"
                android:fontFamily="@font/nanumsquareneoalt"
                android:textStyle="bold"
                android:layout_marginTop="16dp"
                android:backgroundTint="#F4F4F4"
                android:textColor="#0088FF"
                android:textSize="20dp"
                android:typeface="sans"
                app:cornerRadius="11dp"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>